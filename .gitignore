# Compiled class file
target/
*.class

# Package Files
#*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# temp ignore
*.cache
*.diff
*.patch
*.tmp

# Log file
logs/
*.log

# Exception: deploy/logs/ is allowed
!deploy/nginx/logs/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# hprof
*.hprof

# idea ignore
.idea/
*.ipr
*.iml
*.iws

# eclipse ignore
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# system ignore
.DS_Store
Thumbs.db

# node ignore
node_modules
.turbo
dist
coverage
pnpm-lock.yaml
package-lock.json
*.tsbuildinfo

.flattened-pom.xml

# playwright mcp
.playwright-mcp/

# 驱动本地存储目录（运行时生成，不纳入版本控制）
drivers/

# ip2region 离线 IP 数据库（体积约 11MB，不纳入版本控制，开发时手动下载）
ip2region/

# 代码评审目录
.code-reviews/

# Material Symbols 子集字体（build 时由 Vite 插件 subset-material-symbols 自动生成，dev 用 @quasar/extras 完整字体）
sca-skeleton-frontend/packages/ui/fonts/Material_Symbols/

# AI models and agents
.claude/
.cursor/
.opencode/
.windsurf/
.copilot/
.aider/
.codeium/
.mimocode/
.zcode/
