# ============================================================================
# Cloudflare Tunnel systemd 服务单元
#
# 部署路径：/etc/systemd/system/cloudflared.service
# 启用：systemctl enable --now cloudflared
# ============================================================================

[Unit]
Description=Cloudflare Tunnel (cloudflared) for sca-skeleton
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target
Wants=network-online.target

[Service]
# cloudflared 二进制位置（deb 包默认安装到 /usr/local/bin/cloudflared）
# --config 指定 config.yml；--edge 连接 Cloudflare 边缘节点（默认自动选）
ExecStart=/usr/local/bin/cloudflared tunnel --config /root/.cloudflared/config.yml run
ExecStop=/bin/kill -TERM $MAINPID

# 重启策略：异常退出后自动拉起；与 nginx 容器的 restart:no 不冲突
Restart=on-failure
RestartSec=5s

# 以 root 运行（凭证文件在 /root/.cloudflared/，避免权限问题）
User=root
Group=root

# 日志输出到 journald，用 journalctl -u cloudflared 查看
StandardOutput=journal
StandardError=journal

# 资源限制（可选）
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
