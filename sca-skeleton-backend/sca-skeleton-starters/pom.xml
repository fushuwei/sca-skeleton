<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton-backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-starters</artifactId>
    <packaging>pom</packaging>

    <name>SCA Skeleton Backend :: Starters</name>
    <description>Reusable backend starters providing common cross-cutting capabilities</description>

    <modules>
        <!-- 核心基础：异常体系、工具类、TraceId 上下文、UUID 生成规范，所有其他 Starter 的依赖基础 -->
        <module>sca-skeleton-starter-core</module>
        <!-- Web 通用：统一响应体、全局异常处理、TraceId 过滤器、@RateLimit 限流 -->
        <module>sca-skeleton-starter-web</module>
        <!-- 日志增强：操作日志 AOP 注解、MDC 链路追踪辅助 -->
        <module>sca-skeleton-starter-logging</module>
        <!-- MyBatis-Plus 增强：基础实体、审计字段自动填充、分页插件配置 -->
        <module>sca-skeleton-starter-mybatis-plus</module>
        <!-- 远程调用增强：RestClient + HTTP Interface（请求头传递、统一响应解码、错误处理） -->
        <module>sca-skeleton-starter-remote</module>
        <!-- 验证码：图形验证码生成（Java AWT）、Redis 存储与校验 -->
        <module>sca-skeleton-starter-captcha</module>
        <!-- Security 资源服务：OAuth2 Redis 授权存储、不透明令牌自省、资源服务器鉴权 -->
        <module>sca-skeleton-starter-security</module>
    </modules>
</project>
