<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton-starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-starter-mybatis-plus</artifactId>
    <packaging>jar</packaging>

    <name>SCA Skeleton Backend :: Starter :: MyBatis-Plus</name>
    <description>MyBatis-Plus enhanced: base entity, audit auto-fill, pagination plugin</description>

    <dependencies>
        <!-- 核心基础：CurrentUserProvider（审计字段填充）、UuidUtils（ID 生成）等 -->
        <dependency>
            <groupId>io.github.fushuwei</groupId>
            <artifactId>sca-skeleton-starter-core</artifactId>
        </dependency>
        <!-- MyBatis-Plus Spring Boot 4 适配 Starter：ORM 增强，含自动配置、分页等插件 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!--
            MyBatis-Plus JSQLParser 模块（3.5.9 起拆分）：
            PaginationInnerInterceptor、BlockAttackInnerInterceptor 等需要解析 SQL 语法的插件
            已从 mybatis-plus-extension 移至此模块，使用分页或防全表攻击插件必须显式引入。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MySQL Connector/J：JDBC 驱动，运行时依赖，业务模块可按需排除后替换其他数据库驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Lombok：简化基础实体与配置类的样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
