<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton-backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-auth</artifactId>
    <packaging>jar</packaging>

    <name>SCA Skeleton Backend :: Auth</name>
    <description>Authentication service: OAuth2 Authorization Server, custom password grant, opaque access token</description>

    <dependencies>
        <!-- Spring Authorization Server starter（Spring Boot 4 内置工件）：提供标准 OAuth2 授权服务器能力，含 /oauth2/token、/oauth2/introspect、/oauth2/revoke、/oauth2/jwks 等端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
        </dependency>

        <!-- Web 通用 Starter：统一响应体、全局异常处理、TraceId 过滤器 -->
        <dependency>
            <groupId>io.github.fushuwei</groupId>
            <artifactId>sca-skeleton-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus Starter：加载 sys_user、sys_permission 等用于用户认证与权限加载 -->
        <dependency>
            <groupId>io.github.fushuwei</groupId>
            <artifactId>sca-skeleton-starter-mybatis-plus</artifactId>
        </dependency>

        <!-- Redis Starter：令牌黑名单（吊销）、登录失败计数 -->
        <dependency>
            <groupId>io.github.fushuwei</groupId>
            <artifactId>sca-skeleton-starter-redis</artifactId>
        </dependency>

        <!-- Security Starter：OAuth2 Redis 授权存储（共享）；认证中心关闭资源服务器 FilterChain -->
        <dependency>
            <groupId>io.github.fushuwei</groupId>
            <artifactId>sca-skeleton-starter-security</artifactId>
        </dependency>

        <!-- Nacos 服务注册与发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Actuator：暴露健康检查、指标等运维端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok：简化样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：生成可执行 Fat Jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
