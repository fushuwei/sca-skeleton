<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.mapper.SysTenantMapper">

    <!-- 租户分页查询，使用关联子查询查出套餐名称（避免 JOIN 导致 is_deleted 列名歧义）。 -->
    <select id="selectTenantPage" resultType="io.github.fushuwei.scaskeleton.system.entity.SysTenant">
        SELECT t.*,
               (SELECT pk.name FROM sys_tenant_package pk
                WHERE pk.id = t.package_id AND pk.is_deleted = 0) AS package_name
        FROM sys_tenant t
        ${ew.customSqlSegment}
    </select>

</mapper>
