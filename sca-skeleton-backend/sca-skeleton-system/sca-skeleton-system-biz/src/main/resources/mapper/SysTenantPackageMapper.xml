<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.mapper.SysTenantPackageMapper">

    <!-- 套餐分页查询（含权限数量），使用关联子查询避免 GROUP BY 膨胀 -->
    <select id="selectPackagePage" resultType="io.github.fushuwei.scaskeleton.system.entity.SysTenantPackage">
        SELECT p.*,
               (SELECT COUNT(*)
                FROM sys_tenant_package_permission tpp
                WHERE tpp.package_id = p.id
                  AND tpp.is_deleted = 0) AS permission_count
        FROM sys_tenant_package p
        ${ew.customSqlSegment}
    </select>

</mapper>
