<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.mapper.SysNoticeTargetMapper">

    <!-- 根据通知公告 ID 查询接收目标列表 -->
    <select id="selectByNoticeId" resultType="io.github.fushuwei.scaskeleton.system.entity.SysNoticeTarget">
        SELECT * FROM sys_notice_target
        WHERE is_deleted = 0
        AND notice_id = #{noticeId}
        ORDER BY target_type, create_time
    </select>

    <!-- 根据通知公告 ID 物理删除接收目标（避免唯一索引冲突） -->
    <delete id="deleteByNoticeId">
        DELETE FROM sys_notice_target WHERE notice_id = #{noticeId}
    </delete>

</mapper>
