<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.mapper.SysNoticeReadMapper">

    <!-- 根据通知公告 ID 和用户 ID 查询已读记录 -->
    <select id="selectByNoticeIdAndUserId" resultType="io.github.fushuwei.scaskeleton.system.entity.SysNoticeRead">
        SELECT * FROM sys_notice_read
        WHERE is_deleted = 0
        AND notice_id = #{noticeId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

    <!-- 查询用户所有已读通知公告 ID 列表 -->
    <select id="selectReadNoticeIdsByUserId" resultType="java.lang.String">
        SELECT notice_id FROM sys_notice_read
        WHERE is_deleted = 0
        AND user_id = #{userId}
    </select>

    <!-- 批量插入已读记录（用于「全部标记已读」），唯一键 (notice_id, user_id) 冲突时跳过 -->
    <insert id="batchInsertReadRecords">
        INSERT INTO sys_notice_read (id, tenant_id, notice_id, user_id, read_time, create_time)
        VALUES
        <foreach collection="noticeIds" item="noticeId" separator=",">
            (REPLACE(UUID(), '-', ''), #{tenantId}, #{noticeId}, #{userId}, NOW(), NOW())
        </foreach>
        ON DUPLICATE KEY UPDATE id = id
    </insert>

    <!-- 按通知公告 ID 物理删除已读记录（撤回公告时使用），绕过 @TableLogic 逻辑删除 -->
    <delete id="physicalDeleteByNoticeId">
        DELETE FROM sys_notice_read WHERE notice_id = #{noticeId}
    </delete>

</mapper>
