<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.mapper.SysNoticeReadMapper">

    <!-- 根据通知公告 ID 和用户 ID 查询已读记录 -->
    <select id="selectByNoticeIdAndUserId" resultType="io.github.fushuwei.scaskeleton.system.entity.SysNoticeRead">
        SELECT * FROM sys_notice_read
        WHERE is_deleted = 0
        AND notice_id = #{noticeId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
