<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fushuwei.scaskeleton.system.infrastructure.mapper.SysPermissionMapper">

    <select id="selectPermissionsByRoleIds"
            resultType="io.github.fushuwei.scaskeleton.system.infrastructure.entity.SysPermission">
        SELECT DISTINCT p.*
        FROM sys_permission p
                 INNER JOIN sys_role_permission rp
                            ON rp.permission_id = p.id
                                AND rp.is_deleted = 0
                                AND rp.role_id IN
                                    <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
                                        #{roleId}
                                    </foreach>
        WHERE p.is_deleted = 0
          AND p.status = 'enabled'
        ORDER BY p.sort ASC
    </select>

</mapper>
