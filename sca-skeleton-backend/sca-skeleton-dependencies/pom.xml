<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>SCA Skeleton Backend :: Dependencies</name>
    <description>SCA Skeleton unified dependency management BOM</description>

    <properties>
        <spring-boot.version>4.0.6</spring-boot.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <redisson.version>4.3.0</redisson.version>
        <mapstruct.version>1.6.3</mapstruct.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM：管理 Spring Boot 全量依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM：管理 Spring Cloud 全量依赖版本（含 OpenFeign、Gateway、LoadBalancer 等） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba BOM：管理 Nacos、Sentinel、Seata 等阿里云组件版本 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus Spring Boot 4 适配 starter：ORM 增强，支持 Spring Boot 4 与 mybatis-spring 4.x -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Redisson Spring Boot Starter：Redis 客户端增强，提供分布式锁、分布式集合、限流等能力 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!--
                MyBatis-Plus JSQLParser 模块：3.5.9 起将 PaginationInnerInterceptor、
                BlockAttackInnerInterceptor 等需要 SQL 解析的插件拆分到此独立模块，
                使用分页或防全表攻击插件时必须显式引入，版本与 mybatis-plus 保持一致。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ===== 内部 Starter 版本统一管理 ===== -->
            <!-- 核心基础 Starter：异常体系、工具类、TraceId 上下文、UUID 等 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Web 通用 Starter：统一响应体、全局异常处理、TraceId 过滤器、Jackson 配置 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 日志增强 Starter：操作日志 AOP 注解、MDC 链路追踪辅助配置 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-logging</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Redis/Redisson Starter：Redis Template 配置、分布式锁、限流注解 AOP -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus 增强 Starter：基础实体、审计字段自动填充、分页插件 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-mybatis-plus</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenFeign 增强 Starter：请求头传递（TraceId/Authorization）、统一错误解码 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-feign</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 验证码 Starter：图形验证码生成（Java AWT）、Redis 存储与校验 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-captcha</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Security 资源服务 Starter：JWT 解析、资源服务鉴权配置、当前用户上下文 -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
