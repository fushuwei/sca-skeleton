<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>SCA Skeleton Backend :: Dependencies</name>
    <description>SCA Skeleton Backend :: 统一依赖管理 BOM</description>

    <properties>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <redisson.version>4.3.0</redisson.version>
        <uuid-creator.version>6.1.1</uuid-creator.version>
        <hutool.version>5.8.44</hutool.version>
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MyBatis-Plus JSQLParser -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- UUID 生成器，支持 UUID v7 -->
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>uuid-creator</artifactId>
                <version>${uuid-creator.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>


            <!-- ======================================================================== -->
            <!-- 内部 Starter 版本统一管理 -->
            <!-- ======================================================================== -->

            <!-- 核心基础 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Web 通用 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 日志增强 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-logging</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Redis/Redisson Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus 增强 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-mybatis-plus</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenFeign 增强 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-feign</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 验证码 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-captcha</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Security 资源服务 Starter -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
