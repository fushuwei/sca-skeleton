<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fushuwei</groupId>
        <artifactId>sca-skeleton</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sca-skeleton-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>SCA Skeleton Backend :: Dependencies</name>
    <description>SCA Skeleton Backend :: 统一依赖管理 BOM</description>

    <properties>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <redisson.version>4.3.0</redisson.version>
        <uuid-creator.version>6.1.1</uuid-creator.version>
        <hutool.version>5.8.44</hutool.version>
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖版本管理（BOM） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud 依赖版本管理（BOM） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba 依赖版本管理（BOM） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus ORM 增强框架（简化 CRUD 操作） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MyBatis-Plus SQL 解析器（支持分页、租户等插件） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Redisson 分布式锁与 Redis 客户端增强 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- 高性能 UUID 生成工具（支持多种 UUID 版本） -->
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>uuid-creator</artifactId>
                <version>${uuid-creator.version}</version>
            </dependency>

            <!-- Hutool 工具库依赖版本管理（BOM） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SpringDoc OpenAPI 依赖版本管理（BOM） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MapStruct 对象映射框架 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>


            <!-- ======================================================================== -->
            <!-- 内部 Starter 统一管理 -->
            <!-- ======================================================================== -->

            <!-- 项目核心 Starter（自定义基础组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目 Web 层 Starter（自定义 Web 组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目日志 Starter（自定义日志组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-logging</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目 Redis Starter（自定义缓存与数据操作组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目 MyBatis-Plus Starter（自定义持久层组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-mybatis-plus</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目 OpenFeign Starter（自定义服务间调用组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-feign</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目验证码 Starter（自定义验证码组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-captcha</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 项目安全 Starter（自定义认证与授权组件封装） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OAuth2 Redis 共享读模型（opaque token 本地自省） -->
            <dependency>
                <groupId>io.github.fushuwei</groupId>
                <artifactId>sca-skeleton-oauth2-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
