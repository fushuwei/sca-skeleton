# 开发环境 API 基地址（Vite 代理到网关）
VITE_API_BASE_URL=/api-dev

# OAuth2 Authorization Code + PKCE（portal 公共客户端）
VITE_OAUTH_CLIENT_ID=sca-portal-client
VITE_OAUTH_AUTHORIZE_URL=http://localhost:9999/auth/oauth2/authorize
VITE_OAUTH_TOKEN_URL=http://localhost:9999/auth/oauth2/token
VITE_OAUTH_REDIRECT_URI=http://localhost:5174/oauth/callback
VITE_OAUTH_SCOPE=openid profile all
