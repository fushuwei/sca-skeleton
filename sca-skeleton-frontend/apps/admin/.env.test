# 定义测试环境接口基地址。
VITE_API_BASE_URL=/api-test
# 定义测试环境是否启用本地 mock。
VITE_USE_MOCK=false

# OAuth2 Authorization Code + PKCE（admin 公共客户端）
VITE_OAUTH_CLIENT_ID=sca-admin-client
VITE_OAUTH_AUTHORIZE_URL=https://api-test.sca-skeleton.example.com/auth/oauth2/authorize
VITE_OAUTH_TOKEN_URL=https://api-test.sca-skeleton.example.com/auth/oauth2/token
VITE_OAUTH_REDIRECT_URI=https://admin-test.sca-skeleton.example.com/oauth/callback
VITE_OAUTH_SCOPE=openid profile all
