# 开发环境 API 基地址（Vite 代理到网关 http://localhost:9999）
VITE_API_BASE_URL=/api-dev

# OAuth2 Authorization Code + PKCE（admin 公共客户端）
VITE_OAUTH_CLIENT_ID=sca-admin-client
VITE_OAUTH_AUTHORIZE_URL=http://localhost:9999/auth/oauth2/authorize
VITE_OAUTH_TOKEN_URL=http://localhost:9999/auth/oauth2/token
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
VITE_OAUTH_SCOPE=openid profile all

# 关闭 mock，走真实 OAuth2 + 后端 API
VITE_USE_MOCK=false
