{
  "name": "sca-skeleton-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:admin": "turbo run dev --filter=@apps/admin",
    "dev:portal": "turbo run dev --filter=@apps/portal",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@apps/admin",
    "build:portal": "turbo run build --filter=@apps/portal",
    "lint": "turbo run lint",
    "lint:admin": "turbo run lint --filter=@apps/admin",
    "lint:portal": "turbo run lint --filter=@apps/portal",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
